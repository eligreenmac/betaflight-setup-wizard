{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eligreenmac/betaflight-setup-wizard/schemas/drone-model.schema.json",
  "title": "DroneModel",
  "description": "Firmware-version-independent description of what is connected to the flight controller. Produced by the wizard UI, consumed by the config engine. Mirrors src-tauri/src/model.rs and src/types/model.ts.",
  "type": "object",
  "required": ["schemaVersion", "fc", "receiver", "vtx", "gps", "esc"],
  "additionalProperties": false,
  "$defs": {
    "portName": {
      "description": "FC serial port name as reported by config_read_ports. SOFTSERIAL1/2 are valid names but the MVP config engine rejects them (no soft serial in MVP).",
      "type": ["string", "null"],
      "pattern": "^(UART([1-9]|1[0-5])|LPUART1|SOFTSERIAL[12])$"
    },
    "beeperName": {
      "description": "Stable beeper condition names = 4.4/4.5 CLI names. CRASH_FLIP is CRASHFLIP on 2025.12; RC_SMOOTHING_INIT_FAIL does not exist on 2025.12 (warning, not written).",
      "enum": ["GYRO_CALIBRATED", "RX_LOST", "RX_LOST_LANDING", "DISARMING", "ARMING", "ARMING_GPS_FIX", "ARMING_GPS_NO_FIX", "BAT_CRIT_LOW", "BAT_LOW", "GPS_STATUS", "RX_SET", "ACC_CALIBRATION", "ACC_CALIBRATION_FAIL", "READY_BEEP", "MULTI_BEEPS", "DISARM_REPEAT", "ARMED", "SYSTEM_INIT", "ON_USB", "BLACKBOX_ERASE", "CRASH_FLIP", "CAM_CONNECTION_OPEN", "CAM_CONNECTION_CLOSE", "RC_SMOOTHING_INIT_FAIL"]
    },
    "vtxTable": {
      "description": "Betaflight vtxtable; limits from drivers/vtx_table.h (same on 4.4/4.5/2025.12).",
      "type": "object",
      "required": ["bands", "powerLevels"],
      "additionalProperties": false,
      "properties": {
        "bands": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["name", "letter", "factory", "frequencies"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 8 },
              "letter": { "type": "string", "minLength": 1, "maxLength": 1 },
              "factory": { "type": "boolean" },
              "frequencies": { "type": "array", "maxItems": 8, "items": { "type": "integer", "minimum": 0, "maximum": 5999 } }
            }
          }
        },
        "powerLevels": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "label": { "type": "string", "minLength": 1, "maxLength": 3 }
            }
          }
        }
      }
    },
    "elrsDomain": {
      "description": "expresslrs_domain (betaflight cli/settings.c lookupTableFreqDomain). SX1280 builds: ISM2400, CE2400; SX127x builds: the sub-GHz values.",
      "enum": [null, "AU433", "AU915", "EU433", "EU868", "IN866", "FCC915", "ISM2400", "CE2400"]
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "fc": {
      "type": "object",
      "required": ["boardName", "firmwareVersion", "apiVersion"],
      "additionalProperties": false,
      "properties": {
        "boardName": { "type": "string", "examples": ["SPEEDYBEEF405V4"] },
        "firmwareVersion": { "type": "string", "examples": ["4.5.2", "2025.12.1"],
                             "description": "Config engine accepts 4.4.x, 4.5.x and 2025.12.x only; anything else (incl. 2026.6.x) fails with UNSUPPORTED_FIRMWARE." },
        "apiVersion": { "type": "string", "examples": ["1.46"] }
      }
    },
    "receiver": {
      "description": "SERIAL (UART, feature RX_SERIAL) and SPI (onboard receiver, feature RX_SPI, no UART) are mutually exclusive; switching clears the other. MVP config engine supports NONE, SERIAL and SPI+EXPRESSLRS.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["NONE", "SERIAL", "SPI", "PPM", "MSP"] },
        "protocol": {
          "enum": [null, "CRSF", "GHST", "SBUS", "FPORT", "IBUS", "SRXL2", "SPEK1024", "SPEK2048", "SUMD",
                   "EXPRESSLRS", "FRSKY_D", "FRSKY_X", "FRSKY_X_LBT"]
        },
        "port": { "$ref": "#/$defs/portName" },
        "telemetry": { "type": "boolean", "default": true,
                       "description": "CRSF, FPORT, SPI EXPRESSLRS: true enables feature TELEMETRY. Other protocols: ignored (feature left untouched)." },
        "inverted": { "type": "boolean", "default": false },
        "halfDuplex": { "type": "boolean", "default": false },
        "elrsUid": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 0, "maximum": 255 },
                     "minItems": 6, "maxItems": 6,
                     "description": "SPI EXPRESSLRS only. The 6-byte ExpressLRS UID written as expresslrs_uid; null keeps the current UID. The UI derives it from the user's binding phrase with config_elrs_uid (first 6 bytes of MD5('-DMY_BINDING_PHRASE=\"<phrase>\"')) and then discards the phrase. The binding phrase is never part of the model and is never stored or logged." },
        "elrsDomain": { "$ref": "#/$defs/elrsDomain" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "SERIAL" } } },
          "then": { "required": ["protocol", "port"], "properties": { "port": { "type": "string" } } } },
        { "if": { "properties": { "kind": { "const": "SPI" } } },
          "then": { "required": ["protocol"], "properties": { "port": { "type": "null" } } } }
      ]
    },
    "vtx": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["NONE", "ANALOG", "DIGITAL"] },
        "protocol": { "enum": [null, "SMARTAUDIO", "TRAMP", "MSP"] },
        "port": { "$ref": "#/$defs/portName" },
        "digitalSystem": { "enum": [null, "DJI", "WALKSNAIL", "HDZERO", "OTHER"] },
        "region": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$",
                    "description": "ISO-3166 alpha-2; the UI picks a table preset from it, the generator only writes table" },
        "table": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/vtxTable" }], "description": "vtxtable; null = keep the FC's table" },
        "band": { "type": ["integer", "null"], "minimum": 1, "maximum": 8, "description": "vtx_band, 1-based into table; null = keep" },
        "channel": { "type": ["integer", "null"], "minimum": 1, "maximum": 8, "description": "vtx_channel, 1-based; null = keep" },
        "power": { "type": ["integer", "null"], "minimum": 1, "maximum": 7, "description": "vtx_power, 1-based into powerLevels (0 = unknown is not written); the CLI range is 0..VTX_TABLE_MAX_POWER_LEVELS-1, so 1-7 even though a table may list 8 levels; null = keep" }
      }
    },
    "gps": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/$defs/portName" },
        "provider": { "enum": [null, "UBLOX", "NMEA"] },
        "galileo": { "type": ["boolean", "null"],
                     "description": "UBLOX only: gps_ublox_use_galileo. GLONASS/BeiDou are not configurable in 4.4-2025.12; null = keep" },
        "sbasMode": { "enum": [null, "AUTO", "EGNOS", "WAAS", "MSAS", "GAGAN", "NONE"], "description": "gps_sbas_mode; null = keep" }
      }
    },
    "esc": {
      "type": "object",
      "required": ["protocol"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "enum": ["DSHOT150", "DSHOT300", "DSHOT600", "ONESHOT125", "MULTISHOT", "PWM"] },
        "bidirectionalDshot": { "type": "boolean", "default": false },
        "motorPoles": { "type": ["integer", "null"], "minimum": 4, "maximum": 64 },
        "telemetryPort": { "$ref": "#/$defs/portName" },
        "propsOut": { "type": "boolean", "default": false,
                      "description": "yaw_motors_reversed. Per-motor DShot spin-direction reversal is phase 2 (not in the schema)." },
        "idle": { "type": ["integer", "null"], "minimum": 0, "maximum": 2000,
                  "description": "0.01 % units (550 = 5.5 %): dshot_idle_value (4.4/4.5) / motor_idle (2025.12); null = keep" },
        "motorOrder": { "type": ["array", "null"], "minItems": 4, "maxItems": 8, "uniqueItems": true,
                        "items": { "type": "integer", "minimum": 0, "maximum": 7 },
                        "description": "motor_output_reordering: item i = 0-based output for motor i+1, a permutation of 0..n; null = keep" }
      }
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode", "auxChannel", "rangeMin", "rangeMax"],
        "additionalProperties": false,
        "properties": {
          "mode": { "type": "string", "examples": ["ARM", "ANGLE", "BEEPER"] },
          "auxChannel": { "type": "integer", "minimum": 0, "maximum": 13 },
          "rangeMin": { "type": "integer", "minimum": 900, "maximum": 2100, "multipleOf": 25 },
          "rangeMax": { "type": "integer", "minimum": 900, "maximum": 2100, "multipleOf": 25 }
        }
      }
    },
    "airmode": { "enum": [null, "ALWAYS", "SWITCH", "OFF"],
                 "description": "ALWAYS = feature AIRMODE; SWITCH = feature -AIRMODE + an \"AIR MODE\" entry in switches (required); OFF = feature -AIRMODE, AIR MODE ranges removed; null = keep. Same on 4.4/4.5/2025.12 (rc_modes.c: airmode = feature AIRMODE || box AIRMODE)." },
    "removeModes": { "type": "array", "uniqueItems": true,
                     "items": { "enum": ["PREARM", "FLIP OVER AFTER CRASH", "AIR MODE"] },
                     "description": "Optional modes whose ranges on the FC are removed. Optional modes neither listed here nor in switches are kept as they are on the FC." },
    "beepers": {
      "type": ["object", "null"],
      "required": ["disabled"],
      "additionalProperties": false,
      "description": "Full beeper state: beeper -X for listed conditions, beeper X for every other condition the firmware has; null = keep.",
      "properties": {
        "disabled": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/beeperName" } },
        "dshotBeaconDisabled": { "type": ["array", "null"], "uniqueItems": true, "items": { "enum": ["RX_LOST", "RX_SET"] },
                                 "description": "beacon -X for listed, beacon X for the other; null = keep" }
      }
    },
    "sensors": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "true = <sensor>_hardware AUTO (a specific chip already set on the FC is kept), false = NONE, null = keep. Gyro is always on. acc=false makes ANGLE/HORIZON/ALTHOLD/POSHOLD/GPS RESCUE unusable (CONFIG error if such a switch is in the model).",
      "properties": {
        "acc": { "type": ["boolean", "null"] },
        "baro": { "type": ["boolean", "null"] },
        "mag": { "type": ["boolean", "null"] }
      }
    },
    "boardAlignment": {
      "type": ["object", "null"],
      "required": ["roll", "pitch", "yaw"],
      "additionalProperties": false,
      "description": "align_board_roll/pitch/yaw in whole degrees (firmware range -180..360 on 4.4/4.5/2025.12; same values as MSP_BOARD_ALIGNMENT_CONFIG); null = keep",
      "properties": {
        "roll": { "type": "integer", "minimum": -180, "maximum": 360 },
        "pitch": { "type": "integer", "minimum": -180, "maximum": 360 },
        "yaw": { "type": "integer", "minimum": -180, "maximum": 360 }
      }
    },
    "osd": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "OSD layout; null = keep. Writes feature OSD. HD also writes osd_displayport_device = MSP and osd_canvas_width/height = 53/20; analog writes osd_displayport_device = AUTO.",
      "properties": {
        "videoSystem": { "enum": [null, "AUTO", "PAL", "NTSC", "HD"],
                         "description": "vcd_video_system. Grid: PAL 30x16, NTSC 30x13, AUTO 30x13, HD 53x20. null = keep (grid from the FC)." },
        "elements": {
          "type": "array",
          "description": "Elements not listed keep the FC's state.",
          "items": {
            "type": "object",
            "required": ["name", "enabled"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z0-9_]+$",
                        "description": "Betaflight osd_items_e name without OSD_, e.g. MAIN_BATT_VOLTAGE (osd_vbat_pos). Unknown for the firmware = CONFIG error." },
              "enabled": { "type": "boolean", "description": "Visible in all 3 OSD profiles (true) or none (false)." },
              "x": { "type": ["integer", "null"], "minimum": 0, "maximum": 63, "description": "null = default layout position" },
              "y": { "type": ["integer", "null"], "minimum": 0, "maximum": 31 }
            }
          }
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beeper": { "type": ["boolean", "null"] },
        "ledStrip": { "type": ["boolean", "null"] },
        "craftName": { "type": ["string", "null"], "maxLength": 16, "pattern": "^(?:[\\x21\\x22\\x24-\\x2C\\x2E-\\x3E\\x40-\\x7E]|[\\x21\\x22\\x24-\\x3E\\x40-\\x7E][\\x20-\\x22\\x24-\\x3E\\x40-\\x7E]{0,14}[\\x21\\x22\\x24-\\x3E\\x40-\\x7E])?$",
                       "description": "set craft_name (Betaflight CLI rules, 4.4/4.5/2025.12): 1-16 chars of printable ASCII 0x20-0x7E except # (CLI comment) and ? (interactive CLI help), no leading/trailing space (the CLI strips them), not exactly - (the CLI's empty marker); an empty string clears it (written as -); null = keep" }
      }
    }
  },
  "examples": [
    {"schemaVersion": 1, "fc": {"boardName": "SPEEDYBEEF405V4", "firmwareVersion": "4.5.5", "apiVersion": "1.46"}, "receiver": {"kind": "SERIAL", "protocol": "CRSF", "port": "UART2", "telemetry": true}, "vtx": {"kind": "DIGITAL", "protocol": "MSP", "port": "UART1", "digitalSystem": "DJI"}, "gps": {"enabled": false}, "esc": {"protocol": "DSHOT600", "bidirectionalDshot": true, "motorPoles": 14}, "switches": [{"mode": "ARM", "auxChannel": 0, "rangeMin": 1800, "rangeMax": 2100}, {"mode": "AIR MODE", "auxChannel": 1, "rangeMin": 1700, "rangeMax": 2100}, {"mode": "FLIP OVER AFTER CRASH", "auxChannel": 2, "rangeMin": 1700, "rangeMax": 2100}], "airmode": "SWITCH", "removeModes": ["PREARM"], "beepers": {"disabled": ["ON_USB"], "dshotBeaconDisabled": ["RX_SET"]}, "sensors": {"acc": true, "baro": false, "mag": null}, "boardAlignment": {"roll": 0, "pitch": 0, "yaw": 90}, "osd": {"videoSystem": "HD", "elements": [{"name": "MAIN_BATT_VOLTAGE", "enabled": true, "x": 1, "y": 18}, {"name": "LINK_QUALITY", "enabled": true}, {"name": "RSSI_VALUE", "enabled": false}]}},
    {
      "schemaVersion": 1,
      "fc": { "boardName": "SPEEDYBEEF405V4", "firmwareVersion": "4.5.2", "apiVersion": "1.46" },
      "receiver": { "kind": "SERIAL", "protocol": "CRSF", "port": "UART2", "telemetry": true },
      "vtx": { "kind": "DIGITAL", "protocol": "MSP", "port": "UART1", "digitalSystem": "DJI" },
      "gps": { "enabled": true, "port": "UART4", "provider": "UBLOX" },
      "esc": { "protocol": "DSHOT600", "bidirectionalDshot": true, "motorPoles": 14, "propsOut": true },
      "switches": [{ "mode": "ARM", "auxChannel": 0, "rangeMin": 1800, "rangeMax": 2100 }],
      "extras": { "craftName": "QUAD" }
    },
    {
      "schemaVersion": 1,
      "fc": { "boardName": "CRAZYBEEF4SX1280", "firmwareVersion": "4.5.2", "apiVersion": "1.46" },
      "receiver": { "kind": "SPI", "protocol": "EXPRESSLRS", "port": null, "telemetry": true,
                    "elrsUid": [30, 182, 235, 65, 136, 241], "elrsDomain": "ISM2400" },
      "vtx": { "kind": "NONE" },
      "gps": { "enabled": false },
      "esc": { "protocol": "DSHOT300", "bidirectionalDshot": true, "motorPoles": 12 },
      "switches": [{ "mode": "ARM", "auxChannel": 0, "rangeMin": 1700, "rangeMax": 2100 }]
    }
  ]
}
