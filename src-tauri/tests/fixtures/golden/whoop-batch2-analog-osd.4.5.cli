# golden: whoop-batch2-analog-osd on CRAZYBEEF4SX1280 (4.5.5); generated by config::generate, do not edit
# warning: barometer turned on (AUTO): it is detected at the next boot; without one fitted it stays off
feature RX_SPI
feature -RX_SERIAL
feature -RX_PPM
feature -RX_PARALLEL_PWM
feature -RX_MSP
set rx_spi_protocol = EXPRESSLRS
set expresslrs_uid = 30,182,235,65,136,241
set expresslrs_domain = ISM2400
feature TELEMETRY
feature -GPS
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT300
set dshot_bidir = ON
set motor_poles = 12
set yaw_motors_reversed = OFF
feature AIRMODE
aux 0 0 0 1700 2100 0 0
aux 1 1 1 900 1300 0 0
set baro_hardware = AUTO
set align_board_roll = 180
set align_board_pitch = 0
set align_board_yaw = -45
feature OSD
set osd_displayport_device = AUTO
set vcd_video_system = PAL
set osd_vbat_pos = 14391
set osd_rssi_pos = 14369
set osd_tim_1_pos = 439
set osd_craft_name_pos = 14816
