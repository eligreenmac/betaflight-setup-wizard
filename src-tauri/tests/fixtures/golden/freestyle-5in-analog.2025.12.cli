# golden: freestyle-5in-analog on SPEEDYBEEF405V4 (2025.12.1); generated by config::generate, do not edit
serial UART1 2048 115200 57600 0 115200
serial UART2 64 115200 57600 0 115200
serial UART6 2 115200 115200 0 115200
feature RX_SERIAL
feature -RX_SPI
feature -RX_PPM
feature -RX_PARALLEL_PWM
set serialrx_provider = CRSF
set serialrx_inverted = OFF
set serialrx_halfduplex = OFF
feature TELEMETRY
feature GPS
set gps_provider = UBLOX
set gps_auto_config = ON
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT600
set dshot_bidir = ON
set motor_poles = 14
set yaw_motors_reversed = ON
set osd_displayport_device = AUTO
set vcd_video_system = AUTO
aux 0 0 0 1700 2100 0 0
aux 1 1 1 1300 1700 0 0
aux 2 2 1 1700 2100 0 0
aux 3 13 2 1700 2100 0 0
aux 4 35 3 1700 2100 0 0
aux 5 46 4 1700 2100 0 0
