# golden: batch2-freestyle-hd on SPEEDYBEEF405V4 (2026.6.2); generated by config::generate, do not edit
# warning: UART5: removing EscSensor
# warning: beeper condition RC_SMOOTHING_INIT_FAIL does not exist on Betaflight 2026.6; ignored
serial UART1 131073 115200 57600 0 115200
serial UART5 0 115200 57600 0 115200
feature RX_SERIAL
feature -RX_SPI
feature -RX_PPM
feature -RX_PARALLEL_PWM
feature -RX_MSP
set serialrx_provider = CRSF
set serialrx_inverted = OFF
set serialrx_halfduplex = OFF
feature TELEMETRY
feature -GPS
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT600
set dshot_bidir = ON
set motor_poles = 14
set yaw_motors_reversed = ON
set craft_name = BATCH2
feature -AIRMODE
aux 0 0 0 1700 2100 0 0
aux 1 28 1 1700 2100 0 0
aux 2 1 2 1700 2100 0 0
aux 3 13 3 1700 2100 0 0
beeper -GYRO_CALIBRATED
beeper RX_LOST
beeper RX_LOST_LANDING
beeper DISARMING
beeper ARMING
beeper ARMING_GPS_FIX
beeper ARMING_GPS_NO_FIX
beeper BAT_CRIT_LOW
beeper BAT_LOW
beeper GPS_STATUS
beeper RX_SET
beeper ACC_CALIBRATION
beeper ACC_CALIBRATION_FAIL
beeper READY_BEEP
beeper MULTI_BEEPS
beeper DISARM_REPEAT
beeper ARMED
beeper SYSTEM_INIT
beeper -ON_USB
beeper BLACKBOX_ERASE
beeper -CRASHFLIP
beeper CAM_CONNECTION_OPEN
beeper CAM_CONNECTION_CLOSE
beacon RX_LOST
beacon -RX_SET
set acc_hardware = AUTO
set baro_hardware = NONE
set mag_hardware = NONE
set align_board_roll = 0
set align_board_pitch = 0
set align_board_yaw = 90
feature OSD
set osd_displayport_device = MSP
set vcd_video_system = HD
set osd_vbat_pos = 15406
set osd_rssi_pos = 97
set osd_link_quality_pos = 14369
set osd_tim_2_pos = 15950
set osd_flymode_pos = 14913
set osd_craft_name_pos = 14932
set osd_warnings_pos = 14868
set osd_avg_cell_voltage_pos = 15437
