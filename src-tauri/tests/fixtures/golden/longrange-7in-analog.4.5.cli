# golden: longrange-7in-analog on SPEEDYBEEF405V4 (4.5.5); generated by config::generate, do not edit
# warning: UART5: removing EscSensor
serial 0 2048 115200 57600 0 115200
serial 4 0 115200 57600 0 115200
serial 5 2 115200 115200 0 115200
feature RX_SERIAL
feature -RX_SPI
feature -RX_PPM
feature -RX_PARALLEL_PWM
feature -RX_MSP
set serialrx_provider = CRSF
set serialrx_inverted = OFF
set serialrx_halfduplex = OFF
feature TELEMETRY
feature GPS
set gps_provider = UBLOX
set gps_auto_config = ON
set gps_sbas_mode = AUTO
set gps_ublox_use_galileo = ON
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT300
set dshot_bidir = ON
set motor_poles = 14
set yaw_motors_reversed = OFF
set dshot_idle_value = 450
set motor_output_reordering = 1,0,3,2,4,5,6,7
vtxtable bands 2
vtxtable channels 8
vtxtable band 1 BOSCAM_A A CUSTOM 5865 5845 5825 5805 5785 5765 5745 5725
vtxtable band 2 RACEBAND R CUSTOM 5658 5695 5732 5769 5806 5843 5880 5917
vtxtable powerlevels 4
vtxtable powervalues 14 20 26 0
vtxtable powerlabels 25 100 400 PIT
set vtx_band = 2
set vtx_channel = 1
set vtx_power = 2
set osd_displayport_device = AUTO
set vcd_video_system = AUTO
set craft_name = LR7 Chimera
aux 0 0 0 1700 2100 0 0
aux 1 46 4 1700 2100 0 0
