# golden: cinematic-7in-hd on SPEEDYBEEF405V4 (2026.6.2); generated by config::generate, do not edit
# warning: UART5: removing EscSensor
serial UART1 131073 115200 57600 0 115200
serial UART5 0 115200 57600 0 115200
serial UART6 2 115200 115200 0 115200
feature RX_SERIAL
feature -RX_SPI
feature -RX_PPM
feature -RX_PARALLEL_PWM
feature -RX_MSP
set serialrx_provider = CRSF
set serialrx_inverted = OFF
set serialrx_halfduplex = OFF
feature TELEMETRY
feature GPS
set gps_provider = UBLOX
set gps_auto_config = ON
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT300
set dshot_bidir = ON
set motor_poles = 12
set yaw_motors_reversed = OFF
set osd_displayport_device = MSP
set vcd_video_system = HD
aux 0 0 0 1700 2100 0 0
aux 1 1 1 1700 2100 0 0
aux 2 46 2 1700 2100 0 0
aux 3 13 3 1700 2100 0 0
