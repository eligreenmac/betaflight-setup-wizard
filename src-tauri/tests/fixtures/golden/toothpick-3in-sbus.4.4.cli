# golden: toothpick-3in-sbus on SPEEDYBEEF405V4 (4.4.3); generated by config::generate, do not edit
# warning: UART2: removing RxSerial
# warning: UART5: removing EscSensor
# warning: an AIR MODE switch has no effect while feature AIRMODE is on; set airmode to SWITCH
serial 0 64 115200 57600 0 115200
serial 1 8192 115200 57600 0 115200
serial 4 0 115200 57600 0 115200
feature RX_SERIAL
feature -RX_SPI
feature -RX_PPM
feature -RX_PARALLEL_PWM
feature -RX_MSP
set serialrx_provider = SBUS
set serialrx_inverted = OFF
set serialrx_halfduplex = OFF
feature -GPS
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT300
set dshot_bidir = OFF
set motor_poles = 12
set yaw_motors_reversed = OFF
set osd_displayport_device = AUTO
set vcd_video_system = AUTO
aux 0 0 0 1800 2100 0 0
aux 1 28 0 1800 2100 0 0
aux 2 1 1 1700 2100 0 0
