# golden: whoop-65mm-spi-elrs on CRAZYBEEF4SX1280 (2025.12.1); generated by config::generate, do not edit
feature RX_SPI
feature -RX_SERIAL
feature -RX_PPM
feature -RX_PARALLEL_PWM
set rx_spi_protocol = EXPRESSLRS
set expresslrs_uid = 30,182,235,65,136,241
set expresslrs_domain = ISM2400
feature TELEMETRY
feature -GPS
feature -ESC_SENSOR
set motor_pwm_protocol = DSHOT300
set dshot_bidir = ON
set motor_poles = 12
set yaw_motors_reversed = OFF
aux 0 0 0 1700 2100 0 0
aux 1 1 1 900 1300 0 0
aux 2 35 2 1700 2100 0 0
aux 3 13 3 1700 2100 0 0
