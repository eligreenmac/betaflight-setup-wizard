{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Betaflight Setup Wizard",
  "version": "0.1.0",
  "identifier": "io.github.eligreenmac.bfsw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Betaflight Setup Wizard", "width": 1100, "height": 760, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "license": "GPL-3.0-or-later",
    "resources": ["drivers/*"],
    "windows": {
      "nsis": { "languages": ["English", "Hebrew"], "displayLanguageSelector": true }
    }
  }
}
